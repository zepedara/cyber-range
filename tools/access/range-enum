#!/bin/bash
# ============================================================================
# range-enum - SSH forced-command wrapper. Grants read-only VERBS, never a shell.
#
# Pinned via authorized_keys:
#   command="/usr/local/bin/range-enum",no-pty,... ssh-ed25519 AAAA... remote
#
# TWO DESIGN NOTES, both learned the hard way:
#
#  1. The account's login shell must NOT be nologin. sshd executes a forced
#     command as `$SHELL -c "<command>"`, so nologin prints "This account is
#     currently not available." and exits before the wrapper ever runs. Use
#     /bin/sh. This does NOT weaken anything: the command= option overrides
#     whatever the client asks for, so a shell is never reachable.
#
#  2. This wrapper runs UNPRIVILEGED. qm, pvesm and any ssh hop need root, so
#     it does not run them - it reads a cache that root refreshes on a timer
#     (see range-enum-refresh). The remote peer therefore has no privileged
#     code path at all, which matters because the peer is an AI agent exposed
#     to untrusted content.
#
# Every request is logged to syslog with the peer address, allowed or denied.
# ============================================================================
set -uo pipefail
CACHE="/var/lib/range-enum"
cmd="${SSH_ORIGINAL_COMMAND:-help}"
peer="${SSH_CLIENT%% *}"
log(){ logger -t range-enum "peer=${peer:-local} $1"; }

emit(){ # emit <cachefile> - print with explicit data AGE
  local f="${CACHE}/$1.txt"
  if [ ! -r "$f" ]; then
    echo "ERROR: '$1' has no cached data yet. Ask the operator to run range-enum-refresh."
    exit 3
  fi
  local gen age
  gen=$(head -1 "$f" | sed 's/^# generated: //')
  if [ -n "$gen" ]; then
    age=$(( ( $(date -u +%s) - $(date -u -d "$gen" +%s 2>/dev/null || echo 0) ) / 60 ))
    echo "# data generated ${gen} (${age} minutes ago)"
  fi
  tail -n +2 "$f"
}

case "$cmd" in
  help|"")
    log "verb=help"
    cat <<'EOF'
range-enum - read-only enumeration of the reference cyber range

  host-summary     hypervisor version, kernel, CPU, RAM
  guest-list       all VMs: id, name, status, memory, bootdisk
  guest-config ID  config for ONE guest (digits only)
  bridge-list      network bridges and state
  span-check       SPAN bridge discipline (learning / ageing_time)
  storage-list     storage pools, capacity, usage
  zfs-status       zpool list + ARC size
  container-list   Incus containers with addresses
  vlan-coverage    VLANs Zeek observed in the last 24h
  siem-health      Elasticsearch cluster health + doc count
  siem-datasets    telemetry composition over the last 24h
  gates-latest     most recent gate-recorder verdict
  help             this text

NOTES
  * Output is served from a cache refreshed on a timer. Every response begins
    with the generation time and its age in minutes - treat it as a snapshot,
    not a live read, and never report a cached number as current without
    quoting its age.
  * This is read-only. Writes, shells, scans and anything not listed above are
    refused and logged with your address.
  * If you need something absent here, ask the operator. Do not seek another
    route.
EOF
    ;;

  host-summary|guest-list|bridge-list|span-check|storage-list|zfs-status|\
container-list|vlan-coverage|siem-health|siem-datasets|gates-latest)
    log "verb=$cmd"; emit "$cmd" ;;

  guest-config\ *)
    id="${cmd#guest-config }"
    if [[ "$id" =~ ^[0-9]{1,5}$ ]]; then
      log "verb=guest-config id=$id"
      f="${CACHE}/guest-config.txt"
      [ -r "$f" ] || { echo "ERROR: no cached guest config yet."; exit 3; }
      head -1 "$f" | sed 's/^# generated: /# data generated /'
      awk -v want="=== GUEST ${id} ===" '
        $0==want {show=1; next}
        /^=== GUEST /{show=0}
        show' "$f" | sed '/^$/d'
      echo "(end of guest ${id})"
    else
      log "DENIED=guest-config-bad-arg"
      echo "ERROR: guest id must be digits only"; exit 2
    fi
    ;;

  *)
    log "DENIED=$cmd"
    echo "ERROR: '$cmd' is not permitted on this channel. Run 'help' for the allowlist."
    exit 1
    ;;
esac
